{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "dedoc/scramble": "^0.13",
        "doctrine/dbal": "^4.3",
        "google/auth": "^1.52",
        "intervention/image": "^4.0",
        "intervention/image-laravel": "^4.0",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^13.0",
        "laravel/passport": "^13.0",
        "laravel/reverb": "^1.10",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.30",
        "phpdocumentor/shim": "^3.8",
        "qcod/laravel-gamify": "^1.0",
        "sentry/sentry-laravel": "^4.26",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-permission": "^6.20"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "fakerphp/faker": "^1.23",
        "kitloong/laravel-migrations-generator": "^7.4",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5",
        "reliese/laravel": "^1.4"
    },
    "repositories": [
        {
            "type": "package",
            "canonical": true,
            "package": {
                "name": "qcod/laravel-gamify",
                "version": "1.0.9",
                "dist": {
                    "url": "https://api.github.com/repos/qcod/laravel-gamify/zipball/e46650e1de32f6575570d19e06b807d0d907c424",
                    "type": "zip",
                    "reference": "e46650e1de32f6575570d19e06b807d0d907c424"
                },
                "source": {
                    "url": "https://github.com/qcod/laravel-gamify.git",
                    "type": "git",
                    "reference": "e46650e1de32f6575570d19e06b807d0d907c424"
                },
                "require": {
                    "php": "^8.2",
                    "illuminate/contracts": "^8.83.27|^9.51.0|^10.0|^11.0|^12.0|^13.0",
                    "spatie/laravel-package-tools": "^1.19"
                },
                "autoload": {
                    "psr-4": {
                        "QCod\\Gamify\\": "src/"
                    },
                    "files": [
                        "src/helpers.php"
                    ]
                },
                "extra": {
                    "laravel": {
                        "providers": [
                            "QCod\\Gamify\\GamifyServiceProvider"
                        ]
                    }
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "autoload-dev": [
            "composer dump-autoload"
        ],
        "autoload-prod": [
            "composer dump-autoload --optimize"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": false,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpdocumentor/shim": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
