                            "raw": "{{base_url}}/api/test-emails/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "test-emails",
                                ""
                            ]
                        },
                        "description": "Get all available email test routes and their descriptions"
                    }
                }
            ]
        },
