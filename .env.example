APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# SEO Configuration
# Set to false for dev/staging environments to prevent search engine indexing
SEO_INDEXABLE=true
WEBSITE_THEME_03_ENABLED=false
WEBSITE_THEME_04_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,error_daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_PERSISTENT=false
DB_DATABASE=casons_lk_laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In production set SESSION_SECURE_COOKIE=true and SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Sanctum SPA stateful domains (comma-separated, no protocol)
# Add your Angular dev origin and production domain here
SANCTUM_STATEFUL_DOMAINS=localhost:4200,localhost:4300,thetaxi.lk,portal.thetaxi.lk
CORS_ALLOWED_ORIGINS=https://thetaxi.lk,https://www.thetaxi.lk,https://portal.thetaxi.lk,https://dev.casons.lk,http://localhost:4200,http://localhost:4300

# For production: set SESSION_DRIVER=redis, CACHE_STORE=redis, QUEUE_CONNECTION=redis
# and install Laravel Horizon: composer require laravel/horizon

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SCHEDULED_QUEUE_WORKER_ENABLED=false
SCHEDULED_QUEUE_WORKER_QUEUES=default,sms,driver-notifications
SCHEDULED_QUEUE_WORKER_TRIES=3
SCHEDULED_QUEUE_WORKER_TIMEOUT=180
SCHEDULED_QUEUE_WORKER_SLEEP=3
SCHEDULED_QUEUE_WORKER_MAX_TIME=50

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Reverb (WebSocket server — replaces Pusher for production)
# Install: composer require laravel/reverb
# Then run: php artisan reverb:install
# Set BROADCAST_CONNECTION=reverb once configured
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Pusher (keep for existing deployments; prefer Reverb for new production installs)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap2

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

BACKUP_FILESYSTEM_DRIVER=s3
BACKUP_AWS_PREFIX=system-backups

# Google Services Configuration
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=

# Firebase Cloud Messaging (Driver & Rider App Notifications, HTTP v1)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=storage/firebase-service-account.json
# Optional. If empty, the app builds:
# https://fcm.googleapis.com/v1/projects/{FIREBASE_PROJECT_ID}/messages:send
FIREBASE_FCM_HTTP_V1_URL=
FIREBASE_NOTIFICATION_QUEUE=driver-notifications
FIREBASE_ASSIGNMENT_TITLE="New Booking Assigned"
FIREBASE_ASSIGNMENT_BODY="A new booking has been assigned to you."
FIREBASE_CUSTOMER_NOTIFICATION_QUEUE=customer-notifications
FIREBASE_RIDER_ASSIGNMENT_TITLE="Driver Assigned"
FIREBASE_RIDER_ASSIGNMENT_BODY="A driver has been assigned to your booking."

# Booking Configuration
BOOKING_BASE_CURRENCY=LKR

# Service Fee Configuration
BOOKING_SERVICE_FEE_ENABLED=true
BOOKING_SERVICE_FEE_TYPE=fixed
BOOKING_SERVICE_FEE_AMOUNT=750.00
BOOKING_SERVICE_FEE_MIN=0
BOOKING_SERVICE_FEE_MAX=

# Tax Configuration (NBT - Nation Building Tax)
BOOKING_TAX_ENABLED=true
BOOKING_TAX_RATE=0.025
BOOKING_TAX_LABEL=NBT
BOOKING_TAX_DESCRIPTION="Nation Building Tax"

# VAT Configuration
BOOKING_VAT_ENABLED=true
BOOKING_VAT_RATE=0.18
BOOKING_VAT_LABEL=VAT
BOOKING_VAT_DESCRIPTION="Value Added Tax"
BOOKING_VAT_APPLIES_TO_SERVICE_FEE=true

# Advance Payment Configuration
BOOKING_ADVANCE_PAYMENT_ENABLED=true
BOOKING_ADVANCE_PAYMENT_PERCENTAGE=50
BOOKING_ADVANCE_PAYMENT_MIN=1000

# Payment Methods
PAYMENT_ONLINE_ENABLED=true
PAYMENT_BANK_TRANSFER_ENABLED=true
PAYMENT_ONLINE_BANKING_ENABLED=true

# WebXPay Payment Gateway Configuration
WEBXPAY_ENABLED=false
WEBXPAY_MERCHANT_ID=
WEBXPAY_MERCHANT_SECRET=
WEBXPAY_API_URL=https://sandbox.webxpay.com/api
WEBXPAY_RETURN_URL=
WEBXPAY_CANCEL_URL=
WEBXPAY_NOTIFY_URL=
WEBXPAY_CURRENCY=LKR

# OpenAI Configuration for AI Content Generation
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4o

# Sentry error monitoring
# Install: composer require sentry/sentry-laravel
# Then run: php artisan sentry:publish
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_TRACES_SAMPLE_RATE=0.02
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

# Booking route evidence governance. Leave retention unset to disable exports.
BOOKING_ROUTE_RETENTION_DAYS=
BOOKING_ROUTE_EXPORT_MAX_POINTS=10000
BOOKING_ROUTE_ACCESS_LOG_THROTTLE_SECONDS=300
BOOKING_HEALTH_ALERT_THROTTLE_SECONDS=900
BOOKING_ROUTE_USAGE_ENABLED=false
BOOKING_ROUTE_USAGE_STARTS_AT=
BOOKING_ROUTE_USAGE_ENDS_AT=
BOOKING_OPERATIONS_READ_TARGET_MS=2000
BOOKING_OPERATIONS_ACTION_TARGET_MS=3000

# Internal HRM rollout gates. Keep disabled until the matching migration,
# privacy, authorization, operational and acceptance gates are approved.
HR_SYSTEM_USER_ID=
HR_REPORT_ARTIFACT_RETENTION_DAYS=30
HR_NOTIFICATION_MAX_ATTEMPTS=5
HR_NOTIFICATION_LEASE_SECONDS=120
HR_NOTIFICATION_RETRY_MAX_MINUTES=60
HR_SAFETY_EXTERNAL_MAX_ATTEMPTS=5
# Required before wellness consent can be granted or changed. Set only to an approved notice version.
HR_WELLNESS_CONSENT_NOTICE_VERSION=
HR_PEOPLE_CORE_ENABLED=true
HR_ATTENDANCE_INGESTION_ENABLED=true
HR_PHYSICAL_ACCESS_COMMANDS_ENABLED=true
HR_HIKVISION_MAINTENANCE_COMMANDS_ENABLED=true
HR_ATTENDANCE_RESULTS_ENABLED=true
HR_LEAVE_OVERTIME_ENABLED=true
HR_PAYROLL_ENABLED=true
HR_EMPLOYEE_SELF_SERVICE_ENABLED=true
HR_TALENT_ENABLED=true
HR_LEARNING_ENABLED=true
HR_SERVICE_OPERATIONS_ENABLED=true
HR_ADVANCED_ASSETS_ENABLED=true
HR_TRAVEL_ENABLED=true
HR_KNOWLEDGE_ENABLED=true
HR_MEALS_ENABLED=true
HR_RELATIONS_SAFETY_ENABLED=true
HR_ENGAGEMENT_ANALYTICS_ENABLED=true

# Internal Sales rollout gates. Keep disabled until the matching migrations,
# authorization, reconciliation, privacy, Finance and acceptance gates pass.
# Business policy values (approved Sales staff categories, profile-export retention days, FX
# correction policy, commission-dispute response window, business timezone) are no longer set here.
# An authorized Staff member with sales.policy-settings.manage creates them, and a different
# authorized approver with sales.policy-settings.approve approves them, in the running application.
SALES_PROFILES_ENABLED=false
SALES_CANONICAL_RECEIPTS_V2_ENABLED=false
SALES_ROLLING_PAYMENT_SCHEDULES_ENABLED=false
SALES_FX_CORRECTIONS_ENABLED=false
SALES_PAYMENT_FINALITY_ENFORCED=false
SALES_COMMISSION_SHADOW_ENABLED=false
SALES_COMMISSION_ACCRUAL_ENABLED=false
SALES_COMMISSION_NOTIFICATIONS_ENABLED=false
SALES_COMMISSION_STATEMENTS_ENABLED=false
SALES_COMMISSION_PAYOUTS_ENABLED=false
SALES_MANAGEMENT_DASHBOARD_ENABLED=false
SALES_SELF_DASHBOARD_ENABLED=false
SALES_CRM_ENABLED=false
SALES_PERFORMANCE_SNAPSHOTS_ENABLED=false
SALES_PERFORMANCE_ALERT_EVALUATIONS_ENABLED=false
SALES_PERFORMANCE_ALERT_ACTIONS_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
VITE_SENTRY_DSN=

# Cloudflare Turnstile protection for all public inquiry forms
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
