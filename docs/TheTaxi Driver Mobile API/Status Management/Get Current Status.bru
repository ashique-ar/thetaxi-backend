meta {
  name: Get Current Status
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/driver/status
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

settings {
  encodeUrl: true
}

docs {
  Retrieve the driver's current online/offline status and active session information.
}
