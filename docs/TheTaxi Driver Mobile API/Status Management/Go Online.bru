meta {
  name: Go Online
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/driver/status/online
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
      "device_uuid": "{{device_uuid}}",
      "latitude": {{start_latitude}},
      "longitude": {{start_longitude}},
      "metadata": {
          "app_version": "{{app_version}}",
          "os": "{{platform}} {{os_version}}"
      }
  }
}

script:post-response {
  if (res.getStatus() === 200) {
      const response = res.getBody();
      if (response.data && response.data.id) {
          bru.setEnvVar('session_id', response.data.id);
          console.log('✅ Session started:', response.data.id);
      }
  }
}

settings {
  encodeUrl: true
}

docs {
  Set the driver's status to online and start a new session.
}
