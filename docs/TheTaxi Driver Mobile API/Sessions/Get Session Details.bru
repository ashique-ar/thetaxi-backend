meta {
  name: Get Session Details
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/driver/sessions/{{session_id}}
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

settings {
  encodeUrl: true
}

docs {
  Retrieve detailed information about a specific session including route points and statistics.
}
