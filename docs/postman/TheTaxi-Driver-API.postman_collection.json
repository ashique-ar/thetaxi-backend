									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"email\": \"driver@example.com\",\n    \"password\": \"password123\",\n    \"device_fingerprint\": \"a3f5b2c1d4e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2\",\n    \"platform\": \"ios\"\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{base_url}}/api/driver/mobile/auth/login",
									"host": ["{{base_url}}"],
									"path": ["api", "driver", "mobile", "auth", "login"]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
