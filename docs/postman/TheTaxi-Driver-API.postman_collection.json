{
	"info": {
		"_postman_id": "driver-mobile-api-v1",
		"name": "TheTaxi Driver Mobile API",
		"description": "Complete API collection for TheTaxi Driver Mobile Application. Includes authentication, status management, location tracking, sessions, and device management.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
