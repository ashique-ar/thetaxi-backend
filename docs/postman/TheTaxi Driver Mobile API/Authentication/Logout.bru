meta {
  name: Logout
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/driver/auth/logout
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

settings {
  encodeUrl: true
}

docs {
  Logout the authenticated driver by revoking their current token.
}
