meta {
  name: Send Heartbeat
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/driver/heartbeat
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {}
}

settings {
  encodeUrl: true
}

docs {
  Send a heartbeat signal to indicate the driver is still active. Should be sent every 60 seconds while online.
}
