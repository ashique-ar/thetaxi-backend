meta {
  name: Go Offline
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/driver/status/offline
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
      "latitude": {{end_latitude}},
      "longitude": {{end_longitude}}
  }
}

settings {
  encodeUrl: true
}

docs {
  Set the driver's status to offline and close the active session.
}
