[Unit]
Description=TheTaxi Wialon fleet synchronization scheduler
After=network.target
ConditionPathExists=__DEPLOYMENT_DIRECTORY__/artisan

[Service]
Type=simple
User=__PROCESS_USER__
Group=__PROCESS_GROUP__
WorkingDirectory=__DEPLOYMENT_DIRECTORY__
ExecStart=__PHP_BINARY__ artisan schedule:work
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__DEPLOYMENT_DIRECTORY__/storage __DEPLOYMENT_DIRECTORY__/bootstrap/cache

[Install]
WantedBy=multi-user.target
